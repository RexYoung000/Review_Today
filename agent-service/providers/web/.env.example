# Disabled by default. Explicitly select services; Brave requires its own key.
REVIEW_TODAY_SEARCH_PROVIDER=none
REVIEW_TODAY_READ_PROVIDER=local
# To explicitly enable direct Tavily Search + Extract:
# REVIEW_TODAY_SEARCH_PROVIDER=tavily
# REVIEW_TODAY_READ_PROVIDER=tavily
TAVILY_API_KEY=

# Exa hosted MCP: independent key preferred; blank keeps anonymous limits.
EXA_API_KEY=
# REVIEW_TODAY_SEARCH_PROVIDER=exa
# REVIEW_TODAY_READ_PROVIDER=exa

# Standalone DeepSeek Search/Fetch; never falls back to the model's API key.
DEEPSEEK_WEB_API_KEY=
# REVIEW_TODAY_SEARCH_PROVIDER=deepseek
# REVIEW_TODAY_READ_PROVIDER=deepseek

# Explicit failover, disabled by default. Only the listed services are contacted.
REVIEW_TODAY_SEARCH_FALLBACKS=
REVIEW_TODAY_READ_FALLBACKS=
REVIEW_TODAY_CONTEXT_PROVIDER=none
REVIEW_TODAY_TAVILY_KEYLESS=0
# Optional local browser after configured Exa/Tavily/DeepSeek reads fail. The development
# App enables this; install the browser extra and Chrome or Playwright Chromium.
REVIEW_TODAY_BROWSER_FALLBACK=0
BRAVE_API_KEY=
# Development selection:
# REVIEW_TODAY_SEARCH_FALLBACKS=tavily,brave
# REVIEW_TODAY_READ_FALLBACKS=tavily
# REVIEW_TODAY_CONTEXT_PROVIDER=brave
# REVIEW_TODAY_TAVILY_KEYLESS=1
