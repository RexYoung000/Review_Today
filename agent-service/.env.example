REVIEW_TODAY_LLM_PROVIDER=openai_compatible
# To select DeepSeek official: set the above to deepseek and create
# providers/deepseek/.env from its .env.example. Keep the old values below.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_COACH_MODEL=gpt-5.6-terra
OPENAI_RISK_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=90
OPENAI_PROBE_TIMEOUT_SECONDS=45
